# ==============================================================================
# Environment Configuration Template for EIU PDDS Mobile Client
# Copy this file to .env and change EXPO_PUBLIC_API_URL to your backend host.
# ==============================================================================

# Backend Spring Boot API Base URL:
# - Android Emulator: http://10.0.2.2:8080/api/v1
# - iOS Simulator:    http://localhost:8080/api/v1
# - Physical Device:  http://<YOUR_LOCAL_IP>:8080/api/v1 (e.g., http://192.168.1.100:8080/api/v1)
EXPO_PUBLIC_API_URL=http://localhost:8080/api/v1
